# Bypass WordPress for /api/ directory - must come before WP redirect
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^api/.*$ - [L,NC]
</IfModule>

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
